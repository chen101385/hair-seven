# Copy to .env.local and fill in when you're ready to text Kim.
# Leave all Twilio values blank for stub mode: nothing is sent, and every
# submission is printed to the terminal and appended to .submissions.log.

# Twilio account credentials and SMS-capable sending number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Kim's mobile number in E.164 format, for example +16505550123.
NOTIFY_MOBILE_NUMBER=

# The public origin, once a domain is assigned. Used for canonical URLs,
# Open Graph tags, robots.txt and sitemap.xml. Defaults to localhost:3000.
NEXT_PUBLIC_SITE_URL=
