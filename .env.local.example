# Copy to .env.local and fill in when you're ready to send real email.
# Leave RESEND_API_KEY blank and the site runs in stub mode: nothing is sent,
# every submission is printed to the terminal and appended to .submissions.log.

# Resend API key. Blank = stub mode.
RESEND_API_KEY=

# The From address. Must be on a domain you have verified in Resend.
# Resend requires DNS domain verification before it will send from the salon's
# domain — that's a day or two of propagation. Start it when you buy the domain,
# not the night before launch.
RESEND_FROM=Hair 7 <noreply@yourdomain.com>

# Two routes, two inboxes. Point these at two aliases on the same domain
# (book@ and hello@) or at two different mailboxes. Never hardcoded.
NOTIFY_BOOKING_EMAIL=
NOTIFY_QUESTIONS_EMAIL=

# The public origin, once a domain is assigned. Used for canonical URLs,
# Open Graph tags, robots.txt and sitemap.xml. Defaults to localhost:3000.
NEXT_PUBLIC_SITE_URL=
