# Stub mode: leave Twilio blank. Submissions print the SMS to the terminal
# and .submissions.log. Nothing is texted or emailed.
# There is no email path — do not add Resend or NOTIFY_*_EMAIL variables.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Kim receives every form submission at this number (once Twilio is live).
NOTIFY_MOBILE_NUMBER=+16509490796

# Pending requests need durable storage in production so Kim's private link
# works across Vercel functions. The Vercel Marketplace Upstash store injects
# KV_REST_API_URL and KV_REST_API_TOKEN on preview/production. These UPSTASH_*
# names also work if you copy credentials locally. Blank = in-memory preview.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Canonical origin. For local preview use e.g. http://localhost:3001
NEXT_PUBLIC_SITE_URL=
