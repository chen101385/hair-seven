# Copy to .env.local and fill in the three Twilio values from the console:
#   https://console.twilio.com
#
# Leave the Twilio values blank for stub mode: nothing is sent, and every
# submission is printed to the terminal and appended to .submissions.log.
# Restart `npm run dev` after changing this file.

# Account Info → Account SID (starts with AC)
TWILIO_ACCOUNT_SID=

# Account Info → Auth Token
TWILIO_AUTH_TOKEN=

# Phone Numbers → Manage → Active numbers. The SMS-capable Twilio number,
# in E.164 format. This is Twilio's sending number, not Kim's phone.
TWILIO_FROM_NUMBER=

# Destination: Kim's salon number. Override only if she wants texts on a
# different phone than the public listing.
NOTIFY_MOBILE_NUMBER=+16509490796

# The public origin, once a domain is assigned. Used for canonical URLs,
# Open Graph tags, robots.txt and sitemap.xml. Defaults to localhost:3000.
NEXT_PUBLIC_SITE_URL=
