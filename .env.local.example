# Form submissions notify Kim by SMS only. There is no email path and there
# are no email environment variables.
#
# STUB MODE (current): leave the three Twilio values blank. Submissions are
# printed to the terminal as the SMS Kim would receive, and appended to
# .submissions.log. Nothing is texted and nothing is emailed.
#
# LIVE MODE: paste the three Twilio values from https://console.twilio.com
# Restart `npm run dev` after changing this file.

# Account Info → Account SID (starts with AC)
TWILIO_ACCOUNT_SID=

# Account Info → Auth Token
TWILIO_AUTH_TOKEN=

# Phone Numbers → Manage → Active numbers. Twilio's SMS-capable sending
# number in E.164 format — not Kim's phone.
TWILIO_FROM_NUMBER=

# Destination for every form submission. Kim's salon number.
NOTIFY_MOBILE_NUMBER=+16509490796

# Public origin, once a domain is assigned. Canonical URLs, Open Graph,
# robots.txt, sitemap.xml. Not used for notifications.
NEXT_PUBLIC_SITE_URL=
